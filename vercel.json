{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/portal", "destination": "/portal/portal.html" },
    { "source": "/dashboard", "destination": "/portal/dashboard.html" },
    { "source": "/admin", "destination": "/portal/admin.html" },
    { "source": "/create-password", "destination": "/portal/create-password.html" },
    { "source": "/reset-password", "destination": "/portal/reset-password.html" },
    { "source": "/forgot-password", "destination": "/portal/forgot-password.html" },
    { "source": "/email-changed", "destination": "/portal/email-changed.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/team",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/privacy",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/portal",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/dashboard",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/create-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/reset-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/forgot-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/email-changed",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
